{
    "name": "artygrand/pdfplumber-php",
    "description": "Pure PHP port of pdfplumber: characters with coordinates, words, page text, text from an area, lines, rects and tables, without native dependencies",
    "keywords": [
        "pdf",
        "text",
        "table",
        "extract",
        "pdfplumber",
        "pdfminer",
        "parser"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "ArtyGrand",
            "email": "artygrand@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-mbstring": "*",
        "ext-zlib": "*"
    },
    "suggest": {
        "ext-openssl": "Needed for PDFs encrypted with AES",
        "ext-intl": "Needed for the unicodeNorm option",
        "ext-gd": "Needed to draw on page images (toImage)"
    },
    "autoload": {
        "psr-4": {
            "Artygrand\\Pdfplumber\\": "src/"
        }
    },
    "bin": [
        "bin/pdfplumber"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "pestphp/pest": "^5.0"
    }
}
